DATABASE_URL=postgres://lead:lead@localhost:5433/lead_intake
PORT=3210

# mock | anthropic
# mock needs no API key: it runs the rule-based extractor.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Hard ceiling on LLM spend per rolling 24h, in USD.
BUDGET_CEILING_USD=5

# The downstream CRM accepts 60 writes/minute and returns 429 above that.
CRM_RATE_LIMIT_PER_MIN=60

# Left empty, the CRM sink writes to the local deliveries table instead.
CRM_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# The calendar relative dates ("mañana", "el viernes") resolve against.
# Enquiries arrive stamped in UTC; the customer means their own Tuesday.
BUSINESS_TZ=America/Panama
