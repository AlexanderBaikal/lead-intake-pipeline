# Copy to .env — `npm start` and `npm run worker` read it via node --env-file.
DATABASE_URL=postgres://lead:lead@localhost:5433/lead_intake
PORT=3210

# mock | anthropic
# `mock` needs no API key: it runs the same deterministic parser the pipeline
# falls back to when the model returns something unusable. That is what makes
# `npm run eval` runnable in CI.
#
# Every value in this file is validated at boot (src/config.ts). With
# `anthropic` the key is required and the model must be one with a published
# price in src/pricing.ts — otherwise the process refuses to start rather than
# failing on the first lead a worker picks up.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Hard ceiling on LLM spend per rolling 24h, in USD. When the ledger crosses it,
# extraction stops calling the model and falls back to the deterministic parser
# instead of failing the lead.
BUDGET_CEILING_USD=5

# The downstream CRM this pipeline was built against accepts 60 writes/minute
# and returns 429 above that. The token bucket paces delivery to stay under it.
CRM_RATE_LIMIT_PER_MIN=60

# Delivery targets. Left empty, both sinks write to the local `deliveries`
# table so the demo runs with no third-party accounts.
CRM_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# The calendar relative dates ("mañana", "el viernes") resolve against.
# Enquiries arrive stamped in UTC; the customer means their own Tuesday.
BUSINESS_TZ=America/Panama
