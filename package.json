{
  "name": "lead-intake-pipeline",
  "version": "1.0.0",
  "description": "Turns messy inbound enquiries into structured CRM records. Queue, idempotency, LLM extraction with a deterministic fallback, and a hard cost ceiling.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "eval": "tsx evals/run.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "express": "^5.2.1",
    "pg": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.13",
    "@types/pg": "^8.18.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
